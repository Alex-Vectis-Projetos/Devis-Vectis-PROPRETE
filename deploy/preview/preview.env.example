# Modèle de /etc/devis-vectis-preview/api.env (créé à la main sur le VPS, permissions 0600, jamais committé).
# Valeurs de TEST uniquement. Ne copiez rien de /etc/devis-vectis/api.env.
SESSION_SECRET=<générer : openssl rand -hex 32>
ADMIN_EMAILS=preview-admin@preview.invalid
# Pas de GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / MAIL_SETUP_TOKEN / MAIL_SENDER / QUOTE_RECIPIENT : le preview n'envoie aucun e-mail.
